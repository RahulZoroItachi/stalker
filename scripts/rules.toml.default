# stalker classification rules.
#
# Categories are applied when a report is generated, never when data is
# collected — so any rule you add here re-classifies your whole history.
#
# Precedence is by specificity, not file order:
#   tier 1  app (or app_name) AND context
#   tier 2  context only
#   tier 3  app (or app_name) only

default = "unclear"

[[rule]]
app = "com.google.Chrome"
category = "work"

[[rule]]
app = "com.microsoft.edgemac"
category = "fun"

# PWA bundle ids are opaque, install-specific hashes, so match these by name.
#
# idle_counts: in a meeting you listen without touching anything, and nothing the
# sampler can see tells that apart from an empty desk. Chrome takes no named
# "Playing audio" assertion the way Edge does, and for a PWA the audio assertion is
# owned by coreaudiod with the real process buried in a nested field — so Meet
# measured engaged=0 across 132 samples. Without this flag a meeting reads as idle.
[[rule]]
app_name = "Google Meet"
category = "work/Meeting"
idle_counts = true

[[rule]]
app_name = "Gmail"
category = "work"

[[rule]]
app_name = "Google Calendar"
category = "work"

[[rule]]
app = "com.tinyspeck.slackmacgap"
category = "work"

# URL rules are tier 2, so they beat the tier-3 app rules above regardless of
# order. Without these, a YouTube video in Chrome is filed as work purely
# because Chrome is. These need Accessibility granted — without it no URL is
# collected and only the app rules above can fire.
[[rule]]
context = "*youtube.com/*"
category = "fun"

[[rule]]
context = "*netflix.com/*"
category = "fun"

[[rule]]
context = "*reddit.com/*"
category = "fun"

[[rule]]
context = "*x.com/*"
category = "fun"

[[rule]]
context = "*news.ycombinator.com/*"
category = "fun"

# Path rules are app-independent: they cover terminal directories, Finder
# folders, and open documents with the same pattern.
[[rule]]
context = "*/Casey/Work/*"
category = "work"

[[rule]]
context = "*/Casey/Projects/*"
category = "pet-project"

# Zoom is a native app and DOES hold its own assertion, so it is sometimes caught as
# engaged — but only while someone is audible. It still needs idle_counts for the
# stretches where you are listening to a silent screen share.
[[rule]]
app = "us.zoom.xos"
category = "work/Meeting"
idle_counts = true
